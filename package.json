{
  "name": "cv_desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Le CV d'Ali Smaani en bureau 3D low poly, avec une version express en HTML",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sma-ali/CV-Desktop.git"
  },
  "homepage": "https://alismaani.fr",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "next build && playwright test",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run knip && npm test",
    "knip": "knip --no-progress",
    "capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.19.2",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@react-three/postprocessing": "^3.2.2",
    "@react-three/rapier": "2.2.0",
    "next": "16.4.3",
    "postprocessing": "^6.39.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "16.4.3",
    "eslint-config-prettier": "^10.1.8",
    "knip": "^6.44.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}

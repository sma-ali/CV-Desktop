# Variables du serveur, toutes facultatives en local. Copier ce fichier en
# .env (jamais commité) ; un dossier de secrets partagé, facultatif, peut être
# indiqué par CLES_DIR. Sur Vercel : variables du projet. Aucune n'a le
# préfixe NEXT_PUBLIC_. Voir docs/routes-serveur.md.

# Formulaire de contact : boîte de réception et expéditeur validé chez Mailjet
CONTACT_TO=
CONTACT_FROM=
MAILJET_API_KEY=
MAILJET_API_SECRET=
# 1 : n'envoie rien, journalise seulement
CONTACT_DRY_RUN=
# envois permis par IP et par 10 minutes (5 par défaut)
CONTACT_RATE_LIMIT_MAX=

# Adresse https du JSON public des signes de vie ; vide, le site affiche les
# données d'exemple. Variable serveur, jamais en NEXT_PUBLIC_.
LIFE_SIGNS_URL=
